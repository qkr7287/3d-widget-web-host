# ==========================================
# 3d-widget-web-host 환경 변수 예시
# ==========================================
# .env.full / .env.webhost / .env.full.three / .env.webhost.three 복사 후 값 수정해서 사용하세요.
#
# babylon full: 5200(web-host), 5201(3d-widget), 5202(combined)
# babylon webhost-only: 5203(web-host), 위젯은 5201 사용
# three full: 5204(web-host), 5205(3d-widget), 5206(combined)
# three webhost-only: 5207(web-host), 위젯은 5205 사용
# ==========================================

# Vite dev 서버 바인딩 (true=0.0.0.0, "127.0.0.1"=로컬만)
DEV_SERVER_HOST=true

# 각 앱 포트 (컨테이너 내부 포트)
PORT_WEB_HOST=5173
PORT_3D_WIDGET=5174
PORT_COMBINED_APP=6100

# 각 앱 포트 (컨테이너 내부 포트) - Three.js
PORT_WEB_HOST_THREE=5100
PORT_3D_WIDGET_THREE=5101
PORT_COMBINED_APP_THREE=5202

# web-host가 브라우저에 알려줄 위젯 주소
# WIDGET_HOST: 브라우저가 접속할 호스트 (예: 192.168.0.16)
# WIDGET_PUBLIC_PORT: compose 호스트 포트 (위젯=5201)
WIDGET_PROTOCOL=http
WIDGET_HOST=192.168.0.16
WIDGET_PUBLIC_PORT=5200
WIDGET_PUBLIC_PORT_THREE=5201
WIDGET_EMBED_URL_OVERRIDE=5202
